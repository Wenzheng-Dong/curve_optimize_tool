# ---------------------------------------------------------------
# 版本控制约定（2026-07-28 plan_Hi 分支起生效）：
#   计划 / 协作 / 开发日志（_plan.md, _thoughts.md, _dev_logs/,
#   CLAUDE.md, AGENTS.md）纳入【本地】git 追踪，用于留痕与回溯。
#   git push 已在权限层 deny，本地追踪 ≠ 发布；
#   将来放 GitHub 前再决定哪些内容剥离。
#   合并到 main 必须经用户确认。
# ---------------------------------------------------------------

# 优化运行的原始数据（系数轨迹 / checkpoint，可能很大）：不追踪。
# 数据本身是可追溯资产，保存在本地磁盘，由 _runs/ 内 manifest 自述。
/_runs/

# macOS
.DS_Store

# Claude Code 本地权限设置（含机器相关路径）
.claude/settings.local.json

# Python 构建 / 缓存产物
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# 环境
.venv/
venv/

# agent worktrees (transient, not part of the repo)
.claude/worktrees/

# stray scratch dir, not part of this repo
proposals/

# LaTeX build artifacts (manuscripts under _self_study/_write-up/)
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.synctex.gz

# F08 golden-regression snapshots: ~5 MB of .npz regenerated by
# `python _dev_logs/F08_golden.py before|after`. Working data, like _runs/ --
# the script and the compared counts are what get committed, not the blobs.
/_dev_logs/F08_golden/
